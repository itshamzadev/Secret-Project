NODE_ENV=development
SERVICE_NAME=notification-server
SERVICE_VERSION=0.1.0
PORT=5105
MONGODB_URI=mongodb://127.0.0.1:27017/terqivo
REDIS_URL=redis://127.0.0.1:6379
WEB_ORIGIN=http://localhost:3000

JWT_ACCESS_SECRET=replace-with-the-existing-access-secret
JWT_ISSUER=terqivo-connect
JWT_AUDIENCE=terqivo-clients

EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_RECEIPTS_URL=https://exp.host/--/api/v2/push/getReceipts
EXPO_ACCESS_TOKEN=
PUSH_RECEIPT_DELAY_MS=15000
NOTIFICATION_WORKER_INTERVAL_MS=5000
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_MS=1000
NOTIFICATION_RETRY_MAX_MS=60000

INTERNAL_SERVICE_SECRET=replace-with-the-shared-internal-secret
INTERNAL_SERVICE_ISSUER=terqivo-internal
INTERNAL_SERVICE_AUDIENCE=terqivo-services
LOG_LEVEL=info
TRUST_PROXY_HOPS=1
