{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "@terqivo/contracts": ["packages/contracts/src/index.ts"]
    }
  },
  "include": [
    "callserver/**/*.ts",
    "../apps/api/src/**/*.ts",
    "../packages/contracts/src/**/*.ts"
  ]
}
