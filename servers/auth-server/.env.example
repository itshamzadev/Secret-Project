NODE_ENV=development
SERVICE_NAME=auth-server
SERVICE_VERSION=0.1.0
PORT=5101
TRUSTED_PROXY_HOPS=2
MONGODB_URI=mongodb://127.0.0.1:27017/terqivo_connect
WEB_ORIGIN=http://localhost:5173
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=terqivo-connect
JWT_AUDIENCE=terqivo-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=365
AUTH_REGISTER_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_MAX=20
AUTH_REFRESH_RATE_LIMIT_MAX=60
MEDIA_SERVICE_URL=http://127.0.0.1:5104
RELATIONSHIP_SERVICE_URL=http://127.0.0.1:5109
MEDIA_MAX_FILE_SIZE_BYTES=52428800
INTERNAL_SERVICE_SECRET=
