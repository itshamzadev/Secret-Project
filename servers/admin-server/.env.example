NODE_ENV=development
SERVICE_NAME=admin-server
SERVICE_VERSION=0.1.0
PORT=5107
MONGODB_URI=mongodb://127.0.0.1:27017/terqivo_connect
REDIS_URL=redis://127.0.0.1:6379
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-the-existing-client-jwt-secret
JWT_ISSUER=terqivo-connect
JWT_AUDIENCE=terqivo-clients
ADMIN_JWT_SECRET=replace-with-the-existing-admin-jwt-secret
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_LOGIN_RATE_LIMIT_MAX=10
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=
AUTH_SERVICE_URL=http://127.0.0.1:5101
MESSAGE_SERVICE_URL=http://127.0.0.1:5102
CALL_SERVICE_URL=http://127.0.0.1:5103
NOTIFICATION_SERVICE_URL=http://127.0.0.1:5105
INTERNAL_SERVICE_SECRET=replace-with-the-shared-internal-service-secret
INTERNAL_SERVICE_ISSUER=terqivo-internal
INTERNAL_SERVICE_AUDIENCE=terqivo-services
LOG_LEVEL=info
