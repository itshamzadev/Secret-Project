NODE_ENV=development
SERVICE_NAME=call-server
SERVICE_VERSION=0.1.0
PORT=5103
MONGODB_URI=mongodb://127.0.0.1:27017/terqivo
REDIS_URL=redis://127.0.0.1:6379
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_ISSUER=terqivo-connect
JWT_AUDIENCE=terqivo-clients
INTERNAL_SERVICE_SECRET=replace-with-at-least-32-characters
INTERNAL_SERVICE_ISSUER=terqivo-internal
INTERNAL_SERVICE_AUDIENCE=terqivo-services
NOTIFICATION_SERVICE_URL=http://127.0.0.1:5105
RELATIONSHIP_SERVICE_URL=http://127.0.0.1:5109
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
CALL_RING_TIMEOUT_SECONDS=35
CALL_START_RATE_LIMIT_MAX=10
CALL_ACTIVE_TTL_SECONDS=14400
LOG_LEVEL=info
