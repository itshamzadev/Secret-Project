NODE_ENV=production
SERVICE_NAME=message-server
SERVICE_VERSION=0.1.0
PORT=5102
MONGODB_URI=mongodb://private-host:27017/terqivo
REDIS_URL=redis://private-host:6379
WEB_ORIGIN=https://app.terqivo.com
JWT_ACCESS_SECRET=replace-with-the-existing-access-secret
JWT_ISSUER=terqivo-connect
JWT_AUDIENCE=terqivo-clients
E2EFE_ENFORCEMENT_ENABLED=true
MEDIA_MAX_FILE_SIZE_BYTES=52428800
MEDIA_SERVICE_URL=http://127.0.0.1:5104
NOTIFICATION_SERVICE_URL=http://127.0.0.1:5105
RELATIONSHIP_SERVICE_URL=http://127.0.0.1:5109
INTERNAL_SERVICE_SECRET=
INTERNAL_SERVICE_ISSUER=terqivo-internal
INTERNAL_SERVICE_AUDIENCE=terqivo-services
LOG_LEVEL=info
