NODE_ENV=production
SERVICE_NAME=realtime-hub
SERVICE_VERSION=0.1.0
PORT=5108
WEB_ORIGIN=https://app.terqivo.com

REDIS_URL=redis://private-host:6379
AUTH_SERVICE_URL=http://127.0.0.1:5101
MESSAGE_SERVICE_URL=http://127.0.0.1:5102
CALL_SERVICE_URL=http://127.0.0.1:5103

JWT_ACCESS_SECRET=replace-with-the-existing-access-secret
JWT_ISSUER=terqivo-connect
JWT_AUDIENCE=terqivo-clients

INTERNAL_SERVICE_SECRET=replace-with-a-random-32-character-secret
INTERNAL_SERVICE_ISSUER=terqivo-internal
INTERNAL_SERVICE_AUDIENCE=terqivo-services
UPSTREAM_TIMEOUT_MS=15000
LOG_LEVEL=info
