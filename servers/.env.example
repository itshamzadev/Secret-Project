# Distributed-service environment reference. Configure each service from its
# own `.env.example`; never copy secrets into this file.

NODE_ENV=development
PORT=5000

# Use the names read by the active services. The same secret is provisioned
# privately to services that make authenticated internal calls.
INTERNAL_SERVICE_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_ISSUER=terqivo-internal
INTERNAL_SERVICE_AUDIENCE=terqivo-services

# Future private service URLs. Do not put these in mobile clients.
AUTH_SERVICE_URL=http://127.0.0.1:5101
MESSAGE_SERVICE_URL=http://127.0.0.1:5102
CALL_SERVICE_URL=http://127.0.0.1:5103
MEDIA_SERVICE_URL=http://127.0.0.1:5104
NOTIFICATION_SERVICE_URL=http://127.0.0.1:5105
SEARCH_SERVICE_URL=http://127.0.0.1:5106
ADMIN_SERVICE_URL=http://127.0.0.1:5107
REALTIME_HUB_URL=http://127.0.0.1:5108
RELATIONSHIP_SERVICE_URL=http://127.0.0.1:5109
STATUS_SERVICE_URL=http://127.0.0.1:5110
