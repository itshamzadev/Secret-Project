NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/terqivo_connect
REDIS_URL=redis://127.0.0.1:6379
WEB_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret-at-least-32-characters
JWT_ISSUER=terqivo-connect
JWT_AUDIENCE=terqivo-clients
ACCESS_TOKEN_TTL_SECONDS=900
# Sliding persistent session window. A successful refresh extends the session by this many days.
REFRESH_TOKEN_TTL_DAYS=365
AUTH_REGISTER_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_MAX=20
AUTH_REFRESH_RATE_LIMIT_MAX=60
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
CALL_RING_TIMEOUT_SECONDS=35
CALL_START_RATE_LIMIT_MAX=10
CALL_ACTIVE_TTL_SECONDS=14400
# Optional Expo Push Service access token. Keep this server-side and out of source control.
# EXPO_ACCESS_TOKEN=replace-with-an-expo-server-access-token
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_RECEIPTS_URL=https://exp.host/--/api/v2/push/getReceipts
# Optional admin API signing secret. Generate a separate random value; never reuse a client JWT secret.
# ADMIN_JWT_SECRET=replace-with-a-separate-admin-secret-at-least-32-characters
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_LOGIN_RATE_LIMIT_MAX=10
# Optional one-shot bootstrap inputs. Use `pnpm --filter @terqivo/api admin:bootstrap`
# from the workspace, or `node apps/api/dist/modules/admin/admin.bootstrap.js`
# in the production Docker container.
# Remove these values from the environment after creating the first admin.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
# ADMIN_BOOTSTRAP_DISPLAY_NAME=Terqivo Administrator
