{
  "name": "@terqivo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @terqivo/contracts build && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src tests *.json *.ts",
    "test": "pnpm --filter @terqivo/contracts build && vitest run"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@terqivo/contracts": "workspace:*",
    "argon2": "^0.45.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "libphonenumber-js": "^1.13.12",
    "mongoose": "^9.9.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
