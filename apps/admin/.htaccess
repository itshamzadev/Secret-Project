DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve the public assets while keeping the Laravel source tree private.
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]
    RewriteRule ^(favicon\.ico|robots\.txt)$ public/$1 [L]

    # Do not expose application source, configuration, secrets, or dependencies.
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|src|storage|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env|composer\.(?:json|lock)|artisan)(?:/|$) - [F,L,NC]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
